# ---------------------------------------------------------------------------
# Shram Setu frontend (Next.js) - environment configuration
# Copy to ".env.local" (or ".env") and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend. All API calls from the browser go here.
# Use http://localhost:8000 when the backend runs on your machine.
# Leave EMPTY to fall back to the built-in Next.js API routes (offline demo
# with the embedded PGlite database) - not recommended, MongoDB is primary.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
