# ---------------------------------------------------------------------------
# Shram Setu backend - environment configuration
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# REQUIRED: MongoDB Atlas connection string (from Atlas -> Connect -> Drivers).
# Example format:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name inside the cluster (created automatically on first use).
MONGODB_DB_NAME=shram_setu

# REQUIRED FOR PRODUCTION: long random secret used to sign session tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Session lifetime in days.
SESSION_TTL_DAYS=7

# Cookie settings. Leave COOKIE_DOMAIN empty for localhost development.
# Set COOKIE_SECURE=true when the API is served over HTTPS.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS: comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for extra allowed origins (e.g. ephemeral preview hosts):
# CORS_ORIGIN_REGEX=^https://.*\.e2b\.app$

# Platform fee applied on top of the provider amount (0.10 = 10%).
PLATFORM_FEE_PCT=0.10

# Seed the database automatically on startup when it is empty (idempotent).
SEED_ON_START=true
